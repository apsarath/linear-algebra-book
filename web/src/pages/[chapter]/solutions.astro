---
import BookLayout from '../../layouts/BookLayout.astro';
import { bookComponents } from '../../components/book';
import { sectionUrl } from '../../lib/book.mjs';
import { allChapters } from '../../lib/chapters';

export function getStaticPaths() {
  return allChapters()
    .filter((c) => c.available && c.hasSolutions)
    .map((c) => ({ params: { chapter: c.slug } }));
}

const modules = import.meta.glob<{ Content: any }>('../../content/*/solutions.mdx', { eager: true });

const { chapter: slug } = Astro.params;
const chapters = allChapters();
const index = chapters.findIndex((c) => c.slug === slug);
const chapter = chapters[index]!;
const { Content } = modules[`../../content/${slug}/solutions.mdx`]!;
const last = chapter.sections.at(-1);
const nextCh = chapters.slice(index + 1).find((c) => c.available);
---
<BookLayout
  title={`Chapter ${chapter.n} Solutions`}
  current={{ slug: chapter.slug, page: 'solutions' }}
  prev={last ? { href: sectionUrl(chapter.slug, last.slug), label: `${last.number} ${last.title}` } : undefined}
  next={nextCh ? { href: sectionUrl(nextCh.slug, nextCh.sections[0]!.slug), label: `Chapter ${nextCh.n}` } : undefined}
>
  <header class="chapter-head">
    <div class="chapter-kicker">Chapter {chapter.n}</div>
    <h1>Solutions: {chapter.title}</h1>
    <p class="lede">Complete solutions to the review and challenge problems. Each heading links back to its problem.</p>
  </header>
  <article class="prose">
    <Content components={bookComponents} />
  </article>
</BookLayout>
